# Obsidian 专用忽略文件
# 界面布局、工作区（每次打开软件都会变，绝对不用提交）
.obsidian/workspace.json
.obsidian/workspace.json.bak

# 插件本体：默认不提交（体积大、可重装）
.obsidian/plugins/*
!.obsidian/plugins/

# 例外：Dataview 是 MOC / 仪表盘的运行时依赖，提交它才能克隆后"开箱即用"
!.obsidian/plugins/dataview/
!.obsidian/plugins/dataview/**

# 注意：.obsidian/community-plugins.json 故意不忽略。
# 它记录"已启用哪些插件"（本库依赖 Dataview），提交它，克隆方才知道需要装什么。

# 主题、缓存
.obsidian/appearance.json
.obsidian/themes/*

# AI 工具缓存与临时产物
.trae/
.trae-html-share-packages/
.workbuddy/

# 系统垃圾文件（Windows/Mac 都忽略）
.DS_Store
Thumbs.db
*.tmp
*.log

# 你自己的临时文件
*.bak
*.backup

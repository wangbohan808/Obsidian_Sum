# 统一换行符：仓库与工作区一律 LF
# 本库在 Mac 与 Windows 之间通过 GitHub 双向同步，Windows 侧 core.autocrlf=true
# 会把工作区文件转成 CRLF，导致 "已修改但 diff 为空" 的假改动，故在此显式约束。
* text=auto eol=lf

# 纯文本显式声明 LF
*.md text eol=lf
*.base text eol=lf
*.canvas text eol=lf
*.json text eol=lf
*.css text eol=lf
*.js text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.svg text eol=lf

# 二进制：禁止任何换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.bmp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.7z binary
*.mp3 binary
*.m4a binary
*.wav binary
*.flac binary
*.mp4 binary
*.mov binary
*.mkv binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Windows 脚本保持 CRLF，避免部分宿主解析异常
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
